	<property name="ireport.zoom" value="2.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="inp_tgl_awal" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="inp_tgl_akhir" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="inp_category" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select p.title, c.name, concat(u.first_name," ",u.last_name)as createdby, concat(s.first_name," ",s.last_name) as assignto , l.name as location, sl.name as sublocation, date_format(p.edited_at,'%Y-%m-%d') as edited_at, date_format(p.created_at,'%Y-%m-%d') as created_at
from posts p
JOIN users u ON p.user_id = u.id
JOIN users s ON p.assign_to = s.id
JOIN locations l ON p.location_id = l.id
JOIN locations sl ON p.sublocation_id = sl.id
Join categories c on p.category_id = c.id
where date_format(p.created_at,'%Y-%m-%d') between $P{inp_tgl_awal} and $P{inp_tgl_akhir} and category_id like $P{inp_category} and p.visibility = '1' and p.is_scheduled = '0']]>
	</queryString>
